local function MakeDraggable(handle, target)
    local dragging = false
    local dragInput, dragStart, startPos

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = target.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            target.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
end

MakeDraggable(TopBar, MainFrame)
MakeDraggable(ToggleBtn, ToggleBtn)

ToggleBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = not MainFrame.Visible
end)

CloseBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = false
end)

local StatusLabel
local lastStatus = ""
local function SetStatus(msg)
    if msg ~= lastStatus and StatusLabel then
        lastStatus = msg
        StatusLabel.Text = msg
    end
end

local ToggleControllers = {}

local function SetToggleState(key, state)
    Config[key] = state
    local ctrl = ToggleControllers[key]
    if ctrl and ctrl.sync then
        ctrl.sync(state)
    end
end

local function GetPlayerLevel()
    local dataFolder = LocalPlayer:FindFirstChild("Data")
    local levelVal = dataFolder and dataFolder:FindFirstChild("Level")
    if levelVal and typeof(levelVal.Value) == "number" then
        return levelVal.Value
    end
    local stats = LocalPlayer:FindFirstChild("leaderstats")
    local lv = stats and (stats:FindFirstChild("Level") or stats:FindFirstChild("Lv"))
    if lv and typeof(lv.Value) == "number" then
        return lv.Value
    end
    return 1
end

local function GetRoot()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function GetDetectedSeaName()
    local root = GetRoot()
    if root then
        local pos = root.Position
        if pos.Z > 15000 then
            return "Sea 2"
        end
        if pos.Z < -6500 or pos.Y > 1500 then
            return "Sea 3"
        end
        return "Sea 1"
    end
    if Config.SelectedSea == "Sea 1" or Config.SelectedSea == "Sea 2" or Config.SelectedSea == "Sea 3" then
        return Config.SelectedSea
    end
    return "Sea 1"
end

local function GetCurrentSeaName()
    if Config.SelectedSea == "Sea 1" or Config.SelectedSea == "Sea 2" or Config.SelectedSea == "Sea 3" then
        return Config.SelectedSea
    end
    return GetDetectedSeaName()
end

local function IsEntryInCurrentSea(entrySea)
    local activeSea = GetCurrentSeaName()
    local detectedSea = GetDetectedSeaName()
    return entrySea == activeSea and entrySea == detectedSea
end

local function GetLevelEntryByPlayerLevel()
    local activeSea = GetCurrentSeaName()
    local lv = GetPlayerLevel()
    local best = nil
    for _, entry in ipairs(LevelData) do
        if entry.Sea == activeSea then
            best = best or entry
            if lv >= entry.MinLv and lv <= entry.MaxLv then
                return entry
            end
            if lv >= entry.MinLv then
                best = entry
            end
        end
    end
    return best
end

local function HasActiveMovementMode()
    return Config.AutoFarm or Config.AutoBoss or Config.AutoSeaEvent or Config.AutoChest or Config.FreeFly or Config.FlyToTarget ~= nil
end

local hoverVel = Instance.new("BodyVelocity")
hoverVel.Name = "RK_HoverVelocity"
hoverVel.MaxForce = Vector3.new(1e5, 1e5, 1e5)
hoverVel.Velocity = Vector3.zero

local function SetHoverState(enabled)
    local root = GetRoot()
    if enabled and root then
        if hoverVel.Parent ~= root then
            hoverVel.Parent = root
        end
        hoverVel.Velocity = Vector3.zero
    else
        if hoverVel.Parent then
            hoverVel.Parent = nil
        end
    end
end

local function EnforceSeaMatchOrStop()
    if not (Config.AutoFarm or Config.AutoChest) then
        return true
    end
    local detectedSea = GetDetectedSeaName()
    if detectedSea ~= Config.SelectedSea then
        Config.AutoFarm = false
        Config.AutoChest = false
        SetToggleState("AutoFarm", false)
        SetToggleState("AutoChest", false)
        if not HasActiveMovementMode() then
            SetHoverState(false)
        end
        SetStatus("Stopped: In " .. detectedSea .. " != " .. tostring(Config.SelectedSea))
        return false
    end
    return true
end

local function FlyStepTo(targetCFrame)
    local root = GetRoot()
    if not root then return end
    SetHoverState(true)

    local delta = targetCFrame.Position - root.Position
    local dist = delta.Magnitude
    if dist > 6 then
        local stepDist = math.min(dist, Config.FlySpeed * 0.06)
        local nextPos = root.Position + delta.Unit * stepDist
        root.CFrame = CFrame.lookAt(nextPos, targetCFrame.Position)
    else
        root.CFrame = targetCFrame
    end
end

local function StartFlyToDestination(pos, labelText, requiredSea)
    if requiredSea and not IsEntryInCurrentSea(requiredSea) then
        SetStatus("Wrong Sea: Requires " .. tostring(requiredSea))
        return
    end
    if typeof(pos) == "Vector3" then
        Config.FlyToTarget = pos + Vector3.new(0, 4, 0)
        Config.FlyToLabel = labelText or "Destination"
        SetStatus("Flying: " .. Config.FlyToLabel)
    end
end

local function StopFlyToDestination()
    Config.FlyToTarget = nil
    Config.FlyToLabel = nil
    if not HasActiveMovementMode() then
        SetHoverState(false)
    end
    SetStatus("Lv: " .. tostring(GetPlayerLevel()) .. " | Fly Stopped")
end

local function GetLiveTargetPos(targetName, fallbackPos)
    local lowerName = string.lower(targetName)
    local enemies = workspace:FindFirstChild("Enemies")
    if enemies then
        for _, mob in ipairs(enemies:GetChildren()) do
            if string.find(string.lower(mob.Name), lowerName, 1, true) then
                local root = mob:FindFirstChild("HumanoidRootPart")
                local hum = mob:FindFirstChildOfClass("Humanoid")
                if root and hum and hum.Health > 0 then
                    return root.Position
                end
            end
        end
    end
    local npcs = workspace:FindFirstChild("NPCs")
    if npcs then
        for _, npc in ipairs(npcs:GetChildren()) do
            if string.find(string.lower(npc.Name), lowerName, 1, true) then
                local hrp = npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChildWhichIsA("BasePart")
                if hrp then
                    return hrp.Position
                end
            end
        end
    end
    return fallbackPos
end

local function IsSeaEventName(name)
    local lower = string.lower(tostring(name))
    for _, kw in ipairs(SeaEventKeywords) do
        if string.find(lower, kw, 1, true) then
            return true
        end
    end
    return false
end

local function ScanSeaEvents()
    local root = GetRoot()
    local found = {}
    local seen = {}

    local function checkContainer(container)
        if not container then return end
        for _, obj in ipairs(container:GetChildren()) do
            if IsSeaEventName(obj.Name) then
                local part = obj:FindFirstChild("HumanoidRootPart")
                    or obj:FindFirstChildWhichIsA("BasePart")
                    or (obj.PrimaryPart)
                if not part then
                    for _, d in ipairs(obj:GetDescendants()) do
                        if d:IsA("BasePart") then
                            part = d
                            break
                        end
                    end
                end
                local hum = obj:FindFirstChildOfClass("Humanoid")
                local alive = (not hum) or (hum.Health > 0)
                if part and alive then
                    local key = obj.Name .. "_" .. tostring(math.floor(part.Position.X)) .. "_" .. tostring(math.floor(part.Position.Z))
                    if not seen[key] then
                        seen[key] = true
                        local dist = root and (part.Position - root.Position).Magnitude or 0
                        table.insert(found, {
                            name = obj.Name,
                            pos = part.Position,
                            dist = dist
                        })
                    end
                end
            end
        end
