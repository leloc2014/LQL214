    MainFrame.Visible = not MainFrame.Visible
end)

CloseBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = false
end)

local StatusLabel
local lastStatus = ""
local function SetStatus(msg)
    if msg ~= lastStatus and StatusLabel then
        lastStatus = msg
        StatusLabel.Text = msg
    end
end

local function GetPlayerLevel()
    local dataFolder = LocalPlayer:FindFirstChild("Data")
    local levelVal = dataFolder and dataFolder:FindFirstChild("Level")
    if levelVal and typeof(levelVal.Value) == "number" then
        return levelVal.Value
    end
    local stats = LocalPlayer:FindFirstChild("leaderstats")
    local lv = stats and (stats:FindFirstChild("Level") or stats:FindFirstChild("Lv"))
    if lv and typeof(lv.Value) == "number" then
        return lv.Value
    end
    return 1
end

local function GetLevelEntryByPlayerLevel()
    local lv = GetPlayerLevel()
    local best = LevelData[1]
    for _, entry in ipairs(LevelData) do
        if lv >= entry.MinLv and lv <= entry.MaxLv then
            return entry
        end
        if lv >= entry.MinLv then
            best = entry
        end
    end
    return best
end

local function GetRoot()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local hoverVel = Instance.new("BodyVelocity")
hoverVel.Name = "RK_HoverVelocity"
hoverVel.MaxForce = Vector3.new(1e5, 1e5, 1e5)
hoverVel.Velocity = Vector3.zero

local function SetHoverState(enabled)
    local root = GetRoot()
    if enabled and root then
        if hoverVel.Parent ~= root then
            hoverVel.Parent = root
        end
        hoverVel.Velocity = Vector3.zero
    else
        if hoverVel.Parent then
            hoverVel.Parent = nil
        end
    end
end

local function FlyStepTo(targetCFrame)
    local root = GetRoot()
    if not root then return end
    SetHoverState(true)

    local delta = targetCFrame.Position - root.Position
    local dist = delta.Magnitude
    if dist > 6 then
        local stepDist = math.min(dist, Config.FlySpeed * 0.06)
        local nextPos = root.Position + delta.Unit * stepDist
        root.CFrame = CFrame.lookAt(nextPos, targetCFrame.Position)
    else
        root.CFrame = targetCFrame
    end
end

local function TeleportToPos(pos)
    local root = GetRoot()
    if root and typeof(pos) == "Vector3" then
        root.CFrame = CFrame.new(pos + Vector3.new(0, 4, 0))
    end
end

local function GetLiveTargetPos(targetName, fallbackPos)
    local lowerName = string.lower(targetName)
    local enemies = workspace:FindFirstChild("Enemies")
    if enemies then
        for _, mob in ipairs(enemies:GetChildren()) do
            if string.find(string.lower(mob.Name), lowerName, 1, true) then
                local root = mob:FindFirstChild("HumanoidRootPart")
                local hum = mob:FindFirstChildOfClass("Humanoid")
                if root and hum and hum.Health > 0 then
                    return root.Position
                end
            end
        end
    end
    local npcs = workspace:FindFirstChild("NPCs")
    if npcs then
        for _, npc in ipairs(npcs:GetChildren()) do
            if string.find(string.lower(npc.Name), lowerName, 1, true) then
                local hrp = npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChildWhichIsA("BasePart")
                if hrp then
                    return hrp.Position
                end
            end
        end
    end
    return fallbackPos
end

local Pages = {}
local TabButtons = {}

local function CreateTab(name)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 112, 0, 28)
    btn.BackgroundColor3 = RowBg
    btn.Text = name
    btn.TextColor3 = TextDim
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 11
    btn.Parent = Sidebar
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local page = Instance.new("ScrollingFrame")
    page.Name = name .. "Page"
    page.Size = UDim2.new(1, -12, 1, -12)
    page.Position = UDim2.new(0, 6, 0, 6)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.ScrollBarThickness = 2
    page.ScrollBarImageColor3 = Accent
    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    page.Visible = false
    page.Parent = ContentHolder

    local layout = Instance.new("UIListLayout", page)
    layout.Padding = UDim.new(0, 6)
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        page.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10)
    end)

    Pages[name] = page
    TabButtons[name] = btn

    btn.MouseButton1Click:Connect(function()
        for k, p in pairs(Pages) do
            p.Visible = (k == name)
        end
        for k, b in pairs(TabButtons) do
            if k == name then
                b.BackgroundColor3 = Accent
                b.TextColor3 = BgDark
            else
                b.BackgroundColor3 = RowBg
                b.TextColor3 = TextDim
            end
        end
    end)

    return page
end

local function CreateToggle(parent, text, defaultState, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -6, 0, 32)
    frame.BackgroundColor3 = RowBg
    frame.BorderSizePixel = 0
    frame.Parent = parent
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -60, 1, 0)
    lbl.Position = UDim2.new(0, 10, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = TextMain
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = frame

    local sw = Instance.new("TextButton")
    sw.Size = UDim2.new(0, 42, 0, 20)
    sw.Position = UDim2.new(1, -50, 0.5, -10)
    sw.BackgroundColor3 = defaultState and Accent or Color3.fromRGB(51, 65, 85)
    sw.Text = defaultState and "ON" or "OFF"
    sw.TextColor3 = defaultState and BgDark or TextDim
    sw.Font = Enum.Font.GothamBold
    sw.TextSize = 10
    sw.Parent = frame
    Instance.new("UICorner", sw).CornerRadius = UDim.new(1, 0)

    local active = defaultState
    sw.MouseButton1Click:Connect(function()
        active = not active
        sw.BackgroundColor3 = active and Accent or Color3.fromRGB(51, 65, 85)
        sw.Text = active and "ON" or "OFF"
        sw.TextColor3 = active and BgDark or TextDim
        callback(active)
    end)
end

local function CreateButton(parent, text, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -6, 0, 30)
    btn.BackgroundColor3 = RowBg
    btn.Text = text
    btn.TextColor3 = TextMain
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 11
    btn.Parent = parent
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    btn.MouseButton1Click:Connect(callback)
    return btn
end

local function CreateChipRow(parent, options, selectedValue, onSelect)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -6, 0, 28)
    row.BackgroundTransparency = 1
    row.Parent = parent

    local layout = Instance.new("UIListLayout", row)
    layout.FillDirection = Enum.FillDirection.Horizontal
    layout.Padding = UDim.new(0, 6)

    local count = #options
    local widthScale = 1 / count

    for _, opt in ipairs(options) do
        local chip = Instance.new("TextButton")
        chip.Size = UDim2.new(widthScale, -4, 1, 0)
        chip.BackgroundColor3 = (opt == selectedValue) and Accent or RowBg
        chip.Text = opt
        chip.TextColor3 = (opt == selectedValue) and BgDark or TextMain
        chip.Font = Enum.Font.GothamBold
        chip.TextSize = 11
        chip.Parent = row
        Instance.new("UICorner", chip).CornerRadius = UDim.new(0, 6)

        chip.MouseButton1Click:Connect(function()
            onSelect(opt)
        end)
    end
end

local function CreateSection(parent, text)
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -6, 0, 18)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = Accent
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = parent
end

