local function EquipWeapon()
    if not Config.AutoEquipMelee then return end
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not char or not backpack or char:FindFirstChildOfClass("Tool") then return end
    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            tool.Parent = char
            break
        end
    end
end

local function FindMobByNameOrNearest(preferName)
    local root = GetRoot()
    local enemies = workspace:FindFirstChild("Enemies")
    if not root or not enemies then return nil end

    local bestByName, bestDistByName = nil, math.huge
    local nearest, minDist = nil, math.huge
    local lowerPref = preferName and string.lower(preferName) or nil

    for _, mob in ipairs(enemies:GetChildren()) do
        local hum = mob:FindFirstChildOfClass("Humanoid")
        local mRoot = mob:FindFirstChild("HumanoidRootPart")
        if hum and mRoot and hum.Health > 0 then
            local d = (mRoot.Position - root.Position).Magnitude
            if d < minDist then
                minDist = d
                nearest = mob
            end
            if lowerPref and string.find(string.lower(mob.Name), lowerPref, 1, true) and d < bestDistByName then
                bestDistByName = d
                bestByName = mob
            end
        end
    end

    return bestByName or nearest
end

local function BringNearbyMobs(centerPos, radius)
    local enemies = workspace:FindFirstChild("Enemies")
    if not enemies then return end
    local pullCF = CFrame.new(centerPos + Vector3.new(0, 0, -4))
    for _, mob in ipairs(enemies:GetChildren()) do
        local hum = mob:FindFirstChildOfClass("Humanoid")
        local mRoot = mob:FindFirstChild("HumanoidRootPart")
        if hum and mRoot and hum.Health > 0 then
            local d = (mRoot.Position - centerPos).Magnitude
            if d > 5 and d <= radius then
                mRoot.CFrame = pullCF
                mRoot.CanCollide = false
            end
        end
    end
end

local lastQuest = 0
local function TryAutoQuest()
    if tick() - lastQuest < 2.5 then return end
    lastQuest = tick()
    local npcs = workspace:FindFirstChild("NPCs")
    local root = GetRoot()
    if not npcs or not root then return end
    for _, npc in ipairs(npcs:GetChildren()) do
        if string.find(string.lower(npc.Name), "quest", 1, true) then
            local hrp = npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChildWhichIsA("BasePart")
            if hrp and (hrp.Position - root.Position).Magnitude <= 120 then
                for _, rem in ipairs(ReplicatedStorage:GetDescendants()) do
                    if rem:IsA("RemoteEvent") and string.find(string.lower(rem.Name), "quest", 1, true) then
                        pcall(function() rem:FireServer("StartQuest", npc.Name, 1) end)
                        break
                    end
                end
                break
            end
        end
    end
end

local cachedChests = {}
local lastChestScan = 0
local function RefreshChests()
    if tick() - lastChestScan < 4 and #cachedChests > 0 then return end
    lastChestScan = tick()
    table.clear(cachedChests)
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") and string.find(string.lower(v.Name), "chest", 1, true) and v:FindFirstChildWhichIsA("TouchTransmitter") then
            table.insert(cachedChests, v)
        end
    end
end

local function AttackOnce()
    VirtualUser:CaptureController()
    VirtualUser:Button1Down(Vector2.new(1280, 672))
end

LocalPlayer.Idled:Connect(function()
    if Config.AntiAFK then
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new())
    end
end)

RunService.Stepped:Connect(function()
    local root = GetRoot()
    if root and Config.WalkOnWater then
        waterPart.CanCollide = true
        waterPart.Position = Vector3.new(root.Position.X, -0.5, root.Position.Z)
    else
        waterPart.CanCollide = false
    end

    if Config.NoClip and LocalPlayer.Character then
        for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end
end)

task.spawn(function()
    while task.wait(0.06) do
        if Config.AutoFarm or Config.AutoBoss then
            pcall(function()
                local root = GetRoot()
                if not root then return end

                if Config.AutoBoss and Config.SelectedBoss then
                    local bossMob = FindMobByNameOrNearest(Config.SelectedBoss)
                    EquipWeapon()
                    if bossMob and bossMob:FindFirstChild("HumanoidRootPart") then
                        local bRoot = bossMob.HumanoidRootPart
                        local aboveCF = CFrame.new(bRoot.Position + Vector3.new(0, Config.FarmHeight, 0), bRoot.Position) * CFrame.Angles(math.rad(-90), 0, 0)
                        FlyStepTo(aboveCF)
                        AttackOnce()
                        SetStatus("Boss: " .. Config.SelectedBoss)
                        return
                    end
                end

                if Config.AutoFarm then
                    local lvEntry = Config.SelectedLevelMob or (Config.AutoLevelMob and GetLevelEntryByPlayerLevel()) or nil
                    local desiredName = lvEntry and lvEntry.Mob or nil
                    local target = FindMobByNameOrNearest(desiredName)

                    if target and target:FindFirstChild("HumanoidRootPart") then
                        if Config.AutoQuest then TryAutoQuest() end
                        EquipWeapon()
                        local tRoot = target.HumanoidRootPart
                        local aboveCF = CFrame.new(tRoot.Position + Vector3.new(0, Config.FarmHeight, 0), tRoot.Position) * CFrame.Angles(math.rad(-90), 0, 0)
                        FlyStepTo(aboveCF)
                        if Config.BringMob then
                            BringNearbyMobs(tRoot.Position, 45)
                        end
                        AttackOnce()
                        SetStatus(string.format("Lv %d | %s (H:%d)", GetPlayerLevel(), target.Name, Config.FarmHeight))
                    elseif lvEntry then
                        FlyStepTo(CFrame.new(lvEntry.Pos + Vector3.new(0, Config.FarmHeight + 2, 0)))
                        SetStatus(string.format("Lv %d | Move: %s", GetPlayerLevel(), lvEntry.Mob))
                    else
                        SetHoverState(false)
                        SetStatus("Lv " .. tostring(GetPlayerLevel()) .. " | Searching")
                    end
                end
            end)
        else
            SetHoverState(false)
        end
    end
end)

task.spawn(function()
    while task.wait(0.35) do
        if Config.AutoChest then
            pcall(function()
                local root = GetRoot()
                if not root then return end
                RefreshChests()
                for i = #cachedChests, 1, -1 do
                    if not Config.AutoChest then break end
                    local c = cachedChests[i]
                    if c and c.Parent and c:FindFirstChildWhichIsA("TouchTransmitter") then
                        FlyStepTo(c.CFrame + Vector3.new(0, 2, 0))
                        task.wait(0.18)
                    else
                        table.remove(cachedChests, i)
                    end
                end
            end)
        end
    end
end)

task.spawn(function()
    while task.wait(0.08) do
        if Config.FastAttack then
            pcall(AttackOnce)
        end
    end
end)

task.spawn(function()
    while task.wait(1.5) do
        if Config.ESPPlayer then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character and not plr.Character:FindFirstChild("RK_ESP") then
                    local hl = Instance.new("Highlight")
                    hl.Name = "RK_ESP"
                    hl.FillColor = Accent
                    hl.OutlineColor = Color3.new(1, 1, 1)
                    hl.FillTransparency = 0.5
                    hl.Parent = plr.Character
                end
            end
        end
        if Config.ESPChest then
            RefreshChests()
            for _, c in ipairs(cachedChests) do
                if c and c.Parent and not c:FindFirstChild("RK_ChestESP") then
                    local hl = Instance.new("Highlight")
                    hl.Name = "RK_ChestESP"
                    hl.FillColor = Color3.fromRGB(250, 204, 21)
                    hl.FillTransparency = 0.4
                    hl.Parent = c
                end
            end
        end
    end
end)
