local function RefreshTeleportResults()
    for _, child in ipairs(tpResultsHolder:GetChildren()) do
        if not child:IsA("UIListLayout") then
            child:Destroy()
        end
    end

    local keyword = string.lower(Config.TeleportSearch or "")
    if keyword ~= "" then
        local matches = {}
        for _, seaName in ipairs({"Sea 1", "Sea 2", "Sea 3"}) do
            local seaInfo = WorldData[seaName]
            if seaInfo then
                for _, grpName in ipairs({"Islands", "NPCs", "Shops"}) do
                    local grpList = seaInfo[grpName]
                    if grpList then
                        for _, item in ipairs(grpList) do
                            local name = item[1]
                            local pos = item[2]
                            if string.find(string.lower(name), keyword, 1, true)
                                or string.find(string.lower(seaName), keyword, 1, true)
                                or string.find(string.lower(grpName), keyword, 1, true) then
                                table.insert(matches, {
                                    sea = seaName,
                                    group = grpName,
                                    name = name,
                                    pos = pos
                                })
                            end
                        end
                    end
                end
            end
        end

        CreateSection(tpResultsHolder, string.format("All Seas Search (%d)", #matches))
        for _, entry in ipairs(matches) do
            CreateButton(tpResultsHolder, string.format("[%s] %s (%s)", entry.sea, entry.name, entry.group), function()
                Config.SelectedSea = entry.sea
                local dest = (entry.group == "Islands") and entry.pos or GetLiveTargetPos(entry.name, entry.pos)
                TeleportToPos(dest)
                SetStatus(string.format("TP [%s]: %s", entry.sea, entry.name))
            end)
        end
        return
    end

    local seaInfo = WorldData[Config.SelectedSea]
    local list = seaInfo and seaInfo[Config.SelectedTpGroup]
    if not list then return end

    CreateSection(tpResultsHolder, string.format("%s - %s (%d)", Config.SelectedSea, Config.SelectedTpGroup, #list))

    for _, item in ipairs(list) do
        local name = item[1]
        local pos = item[2]
        CreateButton(tpResultsHolder, name, function()
            local dest = (Config.SelectedTpGroup == "Islands") and pos or GetLiveTargetPos(name, pos)
            TeleportToPos(dest)
            SetStatus("TP: " .. name)
        end)
    end
end

local function RebuildTeleportTab()
    for _, child in ipairs(tpChipsHolder:GetChildren()) do
        if not child:IsA("UIListLayout") then
            child:Destroy()
        end
    end

    CreateChipRow(tpChipsHolder, {"Sea 1", "Sea 2", "Sea 3"}, Config.SelectedSea, function(sea)
        Config.SelectedSea = sea
        RebuildTeleportTab()
        if RebuildBossTab then RebuildBossTab() end
    end)

    CreateChipRow(tpChipsHolder, {"Islands", "NPCs", "Shops"}, Config.SelectedTpGroup, function(grp)
        Config.SelectedTpGroup = grp
        RebuildTeleportTab()
    end)

    RefreshTeleportResults()
end

