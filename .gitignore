local SavedCoords = {}
local SaveFileName = "RealKidHub_SavedCoords.json"

local function LoadSavedCoordsFromFile()
    if typeof(isfile) == "function" and typeof(readfile) == "function" then
        local ok, raw = pcall(function()
            if isfile(SaveFileName) then
                return readfile(SaveFileName)
            end
            return nil
        end)
        if ok and type(raw) == "string" and #raw > 0 then
            local decodedOk, decoded = pcall(function()
                return HttpService:JSONDecode(raw)
            end)
            if decodedOk and type(decoded) == "table" then
                SavedCoords = decoded
            end
        end
    end
end

local function SaveCoordsToFile()
    if typeof(writefile) == "function" then
        pcall(function()
            writefile(SaveFileName, HttpService:JSONEncode(SavedCoords))
        end)
    end
end

LoadSavedCoordsFromFile()

