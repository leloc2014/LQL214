local function RebuildSavedList()
    for _, child in ipairs(SavedTab:GetChildren()) do
        if not child:IsA("UIListLayout") then
            child:Destroy()
        end
    end

    CreateButton(SavedTab, "Save Current Position", function()
        local root = GetRoot()
        if root then
            local p = root.Position
            local idx = #SavedCoords + 1
            table.insert(SavedCoords, {name = "Spot " .. idx, x = p.X, y = p.Y, z = p.Z})
            SaveCoordsToFile()
            RebuildSavedList()
        end
    end)

    CreateButton(SavedTab, "Clear All Saved", function()
        table.clear(SavedCoords)
        SaveCoordsToFile()
        RebuildSavedList()
    end)

    for i, item in ipairs(SavedCoords) do
        local pos = Vector3.new(item.x, item.y, item.z)
        CreateButton(SavedTab, string.format("TP %s (%.0f, %.0f, %.0f)", item.name or ("Spot " .. i), item.x, item.y, item.z), function()
            TeleportToPos(pos)
        end)
    end
end

