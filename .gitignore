local function EquipWeapon()
    if not Config.AutoEquipMelee then return end
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not char or not backpack or char:FindFirstChildOfClass("Tool") then return end
    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            tool.Parent = char
            break
        end
    end
end

local function GetNearestEnemy()
    local root = GetRoot()
    local enemiesFolder = workspace:FindFirstChild("Enemies")
    if not root or not enemiesFolder then return nil end

    local nearest, minDist = nil, math.huge
    for _, mob in ipairs(enemiesFolder:GetChildren()) do
        local hum = mob:FindFirstChildOfClass("Humanoid")
        local mobRoot = mob:FindFirstChild("HumanoidRootPart")
        if hum and mobRoot and hum.Health > 0 then
            local dist = (mobRoot.Position - root.Position).Magnitude
            if dist < minDist then
                minDist = dist
                nearest = mob
            end
        end
    end
    return nearest
end

local function FindSpecificBoss(bossName)
    if not bossName then return nil end
    local enemiesFolder = workspace:FindFirstChild("Enemies")
    if not enemiesFolder then return nil end
    local lowerBoss = string.lower(bossName)
    for _, mob in ipairs(enemiesFolder:GetChildren()) do
        if string.find(string.lower(mob.Name), lowerBoss, 1, true) then
            local hum = mob:FindFirstChildOfClass("Humanoid")
            local mobRoot = mob:FindFirstChild("HumanoidRootPart")
            if hum and mobRoot and hum.Health > 0 then
                return mob
            end
        end
    end
    return nil
end

local function BringNearbyMobs(centerPos, radius)
    local enemiesFolder = workspace:FindFirstChild("Enemies")
    if not enemiesFolder then return end
    local pullPos = CFrame.new(centerPos + Vector3.new(0, 0, -4))
    for _, mob in ipairs(enemiesFolder:GetChildren()) do
        local hum = mob:FindFirstChildOfClass("Humanoid")
        local mobRoot = mob:FindFirstChild("HumanoidRootPart")
        if hum and mobRoot and hum.Health > 0 then
            local d = (mobRoot.Position - centerPos).Magnitude
            if d > 5 and d <= radius then
                mobRoot.CFrame = pullPos
                mobRoot.CanCollide = false
            end
        end
    end
end

local lastQuestTime = 0
local function TryAutoQuest()
    if tick() - lastQuestTime < 2.5 then return end
    lastQuestTime = tick()

    local npcsFolder = workspace:FindFirstChild("NPCs")
    local root = GetRoot()
    if not npcsFolder or not root then return end

    for _, npc in ipairs(npcsFolder:GetChildren()) do
        if string.find(string.lower(npc.Name), "quest", 1, true) then
            local hrp = npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChildWhichIsA("BasePart")
            if hrp and (hrp.Position - root.Position).Magnitude <= 120 then
                for _, rem in ipairs(ReplicatedStorage:GetDescendants()) do
                    if rem:IsA("RemoteEvent") and string.find(string.lower(rem.Name), "quest", 1, true) then
                        pcall(function()
                            rem:FireServer("StartQuest", npc.Name, 1)
                        end)
                        break
                    end
                end
                break
            end
        end
    end
end

local cachedChests = {}
local lastChestScan = 0
local function RefreshChestCache()
    if tick() - lastChestScan < 4 and #cachedChests > 0 then return end
    lastChestScan = tick()
    table.clear(cachedChests)
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") and string.find(string.lower(v.Name), "chest", 1, true) and v:FindFirstChildWhichIsA("TouchTransmitter") then
            table.insert(cachedChests, v)
        end
    end
end

local function TriggerAttack()
    VirtualUser:CaptureController()
    VirtualUser:Button1Down(Vector2.new(1280, 672))
end

LocalPlayer.Idled:Connect(function()
    if Config.AntiAFK then
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new())
    end
end)

RunService.Stepped:Connect(function()
    local root = GetRoot()
    if root and Config.WalkOnWater then
        waterPart.CanCollide = true
        waterPart.Position = Vector3.new(root.Position.X, -0.5, root.Position.Z)
    else
        waterPart.CanCollide = false
    end

    if Config.NoClip and LocalPlayer.Character then
        for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end
end)

task.spawn(function()
    while task.wait(0.12) do
        if Config.AutoFarm or Config.AutoBoss then
            pcall(function()
                local root = GetRoot()
                if not root then return end

                if Config.AutoBoss and Config.SelectedBoss then
                    local seaInfo = WorldData[Config.SelectedSea]
                    local fallback = seaInfo and seaInfo.Bosses and seaInfo.Bosses[Config.SelectedBoss]
                    local bossMob = FindSpecificBoss(Config.SelectedBoss)
                    EquipWeapon()
                    if bossMob and bossMob:FindFirstChild("HumanoidRootPart") then
                        local bRoot = bossMob.HumanoidRootPart
                        local goalCF = bRoot.CFrame * CFrame.new(0, Config.FarmHeight, 0) * CFrame.Angles(math.rad(-90), 0, 0)
                        SmoothMoveTo(goalCF, Config.FlySpeed)
                        TriggerAttack()
                        SetStatus("Status: Bossing " .. Config.SelectedBoss)
                        return
                    elseif fallback then
                        SmoothMoveTo(CFrame.new(fallback + Vector3.new(0, 6, 0)), Config.FlySpeed)
                        SetStatus("Status: Waiting Boss " .. Config.SelectedBoss)
                        return
                    end
                end

                if Config.AutoFarm then
                    local target = GetNearestEnemy()
                    if target then
                        if Config.AutoQuest then
                            TryAutoQuest()
                        end
                        EquipWeapon()
                        local targetRoot = target:FindFirstChild("HumanoidRootPart")
                        if targetRoot then
                            local goalCF = targetRoot.CFrame * CFrame.new(0, Config.FarmHeight, 0) * CFrame.Angles(math.rad(-90), 0, 0)
                            SmoothMoveTo(goalCF, Config.FlySpeed)
                            if Config.BringMob then
                                BringNearbyMobs(targetRoot.Position, 45)
                            end
                            TriggerAttack()
                            SetStatus("Status: Farming " .. target.Name)
                        end
                    else
                        SetStatus("Status: Searching Mob (" .. Config.SelectedSea .. ")")
                    end
                end
            end)
        end
    end
end)

task.spawn(function()
    while task.wait(0.35) do
        if Config.AutoChest then
            pcall(function()
                local root = GetRoot()
                if not root then return end
                RefreshChestCache()
                for i = #cachedChests, 1, -1 do
                    if not Config.AutoChest then break end
                    local chest = cachedChests[i]
                    if chest and chest.Parent and chest:FindFirstChildWhichIsA("TouchTransmitter") then
                        SmoothMoveTo(chest.CFrame + Vector3.new(0, 2, 0), Config.FlySpeed)
                        SetStatus("Status: Collecting Chest")
                        task.wait(0.2)
                    else
                        table.remove(cachedChests, i)
                    end
                end
            end)
        end
    end
end)

task.spawn(function()
    while task.wait(0.08) do
        if Config.FastAttack then
            pcall(TriggerAttack)
        end
    end
end)

task.spawn(function()
    while task.wait(1.5) do
        if Config.ESPPlayer then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character and not plr.Character:FindFirstChild("RK_ESP") then
                    local hl = Instance.new("Highlight")
                    hl.Name = "RK_ESP"
                    hl.FillColor = Color3.fromRGB(0, 220, 130)
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.FillTransparency = 0.5
                    hl.Parent = plr.Character
                end
            end
        end
        if Config.ESPChest then
            RefreshChestCache()
            for _, chest in ipairs(cachedChests) do
                if chest and chest.Parent and not chest:FindFirstChild("RK_ChestESP") then
                    local hl = Instance.new("Highlight")
                    hl.Name = "RK_ChestESP"
                    hl.FillColor = Color3.fromRGB(255, 215, 0)
                    hl.FillTransparency = 0.4
                    hl.Parent = chest
                end
            end
        end
    end
end)
