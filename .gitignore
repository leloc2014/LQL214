local function RebuildSavedCoordList()
    for _, child in ipairs(CustomCoordTab:GetChildren()) do
        if not child:IsA("UIListLayout") then
            child:Destroy()
        end
    end

    CreateSectionLabel(CustomCoordTab, "Save & Teleport Current Position")

    CreateButton(CustomCoordTab, "Save Current Position", function()
        local root = GetRoot()
        if root then
            local p = root.Position
            local index = #SavedCoords + 1
            table.insert(SavedCoords, {
                name = "Spot " .. index,
                x = p.X,
                y = p.Y,
                z = p.Z
            })
            SaveCoordsToFile()
            SetStatus(string.format("Saved Spot %d (%.0f, %.0f, %.0f)", index, p.X, p.Y, p.Z))
            RebuildSavedCoordList()
        end
    end)

    CreateButton(CustomCoordTab, "Clear All Saved Coords", function()
        table.clear(SavedCoords)
        SaveCoordsToFile()
        SetStatus("Cleared all saved coords")
        RebuildSavedCoordList()
    end)

    CreateSectionLabel(CustomCoordTab, "Saved Positions (" .. tostring(#SavedCoords) .. ")")

    for i, item in ipairs(SavedCoords) do
        local pos = Vector3.new(item.x, item.y, item.z)
        CreateButton(CustomCoordTab, string.format("TP %s (%.0f, %.0f, %.0f)", item.name or ("Spot " .. i), item.x, item.y, item.z), function()
            TeleportToPos(pos)
            SetStatus("TP to " .. (item.name or ("Spot " .. i)))
        end)
    end
end

local function RebuildAllCoordLists()
    for _, page in ipairs({BossRaidTab, IslandsTab, NPCsTab, MobsTab}) do
        for _, child in ipairs(page:GetChildren()) do
            if not child:IsA("UIListLayout") then
                child:Destroy()
            end
        end
    end

    local seaInfo = WorldData[Config.SelectedSea]
    if not seaInfo then return end

    CreateToggle(BossRaidTab, "Auto Farm Selected Boss", false, function(val)
        Config.AutoBoss = val
    end)

    CreateSectionLabel(BossRaidTab, Config.SelectedSea .. " - Bosses")
    for name, pos in pairs(seaInfo.Bosses) do
        CreateButton(BossRaidTab, string.format("Boss: %s (%.0f, %.0f, %.0f)", name, pos.X, pos.Y, pos.Z), function()
            Config.SelectedBoss = name
            TeleportToPos(GetLiveTargetPos(name, pos))
            SetStatus("Status: Target Boss " .. name)
        end)
    end

    CreateSectionLabel(BossRaidTab, Config.SelectedSea .. " - Raids & Special Spots")
    for name, pos in pairs(seaInfo.RaidsAndEvents) do
        CreateButton(BossRaidTab, string.format("%s (%.0f, %.0f, %.0f)", name, pos.X, pos.Y, pos.Z), function()
            TeleportToPos(pos)
            SetStatus("Status: TP " .. name)
        end)
    end

    CreateSectionLabel(IslandsTab, Config.SelectedSea .. " - Islands")
    for name, pos in pairs(seaInfo.Islands) do
        CreateButton(IslandsTab, string.format("%s (%.0f, %.0f, %.0f)", name, pos.X, pos.Y, pos.Z), function()
            TeleportToPos(pos)
            SetStatus("Status: TP " .. name)
        end)
    end

    CreateSectionLabel(NPCsTab, Config.SelectedSea .. " - NPCs")
    for name, pos in pairs(seaInfo.NPCs) do
        CreateButton(NPCsTab, string.format("%s (%.0f, %.0f, %.0f)", name, pos.X, pos.Y, pos.Z), function()
            TeleportToPos(GetLiveTargetPos(name, pos))
            SetStatus("Status: TP " .. name)
        end)
    end

    CreateSectionLabel(NPCsTab, Config.SelectedSea .. " - Shops & Fruit")
    for name, pos in pairs(seaInfo.ShopsAndFruit) do
        CreateButton(NPCsTab, string.format("%s (%.0f, %.0f, %.0f)", name, pos.X, pos.Y, pos.Z), function()
            TeleportToPos(GetLiveTargetPos(name, pos))
            SetStatus("Status: TP " .. name)
        end)
    end

    CreateSectionLabel(MobsTab, Config.SelectedSea .. " - Mobs")
    for name, pos in pairs(seaInfo.Mobs) do
        CreateButton(MobsTab, string.format("%s (%.0f, %.0f, %.0f)", name, pos.X, pos.Y, pos.Z), function()
            TeleportToPos(GetLiveTargetPos(name, pos))
            SetStatus("Status: TP " .. name)
        end)
    end
end

for _, seaName in ipairs({"Sea 1", "Sea 2", "Sea 3"}) do
    CreateButton(MainTab, "Load " .. seaName .. " All Coords", function()
        Config.SelectedSea = seaName
        SetStatus("Status: Loaded " .. seaName .. " Coords")
        RebuildAllCoordLists()
    end)
end

