local function getCharacter()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function getRoot()
    local char = getCharacter()
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid()
    local char = getCharacter()
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function getPlayerLevel()
    local data = LocalPlayer:FindFirstChild("Data")
    local lv = data and data:FindFirstChild("Level")
    if lv and typeof(lv.Value) == "number" then
        return lv.Value
    end
    local stats = LocalPlayer:FindFirstChild("leaderstats")
    local statLv = stats and (stats:FindFirstChild("Level") or stats:FindFirstChild("Lv"))
    if statLv and typeof(statLv.Value) == "number" then
        return statLv.Value
    end
    return 1
end

local function getDetectedSea()
    local root = getRoot()
    if root then
        local pos = root.Position
        if pos.Z > 15000 then
            return "Sea 2"
        end
        if pos.Z < -6500 or pos.Y > 1500 then
            return "Sea 3"
        end
    end
    local lv = getPlayerLevel()
    if lv >= 1500 then
        return "Sea 3"
    elseif lv >= 700 then
        return "Sea 2"
    end
    return "Sea 1"
end

local function getLevelEntry()
    local lv = getPlayerLevel()
    local currentSea = getDetectedSea()
    local fallback = nil

    for _, entry in ipairs(LevelTable) do
        if entry.Sea == currentSea then
            fallback = fallback or entry
            if lv >= entry.MinLv and lv <= entry.MaxLv then
                return entry
            end
            if lv >= entry.MinLv then
                fallback = entry
            end
        end
    end

    if fallback then
        return fallback
    end

    for _, entry in ipairs(LevelTable) do
        if lv >= entry.MinLv and lv <= entry.MaxLv then
            return entry
        end
    end

    return LevelTable[1]
end

local function setStatus(msg)
    local gui = LocalPlayer:FindFirstChild("PlayerGui")
    local replica = gui and gui:FindFirstChild("RealKidReplicaUI")
    local statusLbl = replica and replica:FindFirstChild("StatusBanner", true)
    if statusLbl and statusLbl:IsA("TextLabel") then
        statusLbl.Text = "Status: " .. tostring(msg)
    end
end

local function refreshLevelInfoLabel()
    if State.LevelInfoLabel and State.LevelInfoLabel.Parent then
        local entry = getLevelEntry()
        local lv = getPlayerLevel()
        State.LevelInfoLabel.Text = string.format("  Lv.%d (%s) -> Mob: %s", lv, entry.Sea, entry.Mob)
    end
end

local function refreshEliteProgressLabel()
    if State.EliteProcessLabel and State.EliteProcessLabel.Parent then
        State.EliteProcessLabel.Text = "  Elites Process: " .. tostring(State.EliteCount)
    end
    if State.CakeProcessLabel and State.CakeProcessLabel.Parent then
        State.CakeProcessLabel.Text = "  Cake Prince Progress: " .. tostring(State.CakeMobCount) .. " / 500"
    end
end

local function isEliteBossName(name)
    local lower = string.lower(tostring(name))
    for _, eName in ipairs(EliteNames) do
        if string.find(lower, string.lower(eName), 1, true) then
            return true
        end
    end
    return false
end

local function trackEliteKills()
    local enemiesFolder = workspace:FindFirstChild("Enemies")
    local currentAlive = {}

    if enemiesFolder then
        for _, mob in ipairs(enemiesFolder:GetChildren()) do
            if isEliteBossName(mob.Name) then
                local hum = mob:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    currentAlive[mob] = true
                    State.ActiveElites[mob] = true
                end
            end
        end
    end

    for mob, _ in pairs(State.ActiveElites) do
        if not currentAlive[mob] then
            State.ActiveElites[mob] = nil
            State.EliteCount = State.EliteCount + 1
            refreshEliteProgressLabel()
            setStatus("Elite defeated! Count: " .. tostring(State.EliteCount))
        end
    end
end

local function cycleItem(list, current)
    for i, val in ipairs(list) do
        if val == current then
            return list[(i % #list) + 1]
        end
    end
    return list[1]
end

local function equipWeapon(wType)
    if not Config.AutoEquipWeapon then return nil end
    local char = getCharacter()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not char or not backpack then return nil end

    local equipped = char:FindFirstChildOfClass("Tool")
    if equipped and (wType == nil or equipped.ToolTip == wType) then
        return equipped
    end

    for _, item in ipairs(backpack:GetChildren()) do
        if item:IsA("Tool") and (wType == nil or item.ToolTip == wType) then
            local hum = getHumanoid()
            if hum then
                hum:EquipTool(item)
                return item
            end
        end
    end

    if wType ~= nil then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") then
                local hum = getHumanoid()
                if hum then
                    hum:EquipTool(item)
                    return item
                end
            end
        end
    end

    return equipped
end

local function setNoclip(active)
    local char = LocalPlayer.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = not active
        end
    end
end

local function tweenToCFrame(targetCF)
    local root = getRoot()
    local hum = getHumanoid()
    if not root or not hum or hum.Health <= 0 then return end

    setNoclip(true)
    if hum.Sit then
        hum.Sit = false
    end

    local dist = (root.Position - targetCF.Position).Magnitude
    local duration = math.clamp(dist / math.max(Config.FarmSpeed, 50), 0.05, 8)
    local info = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(root, info, { CFrame = targetCF })
    tween:Play()
    tween.Completed:Wait()
end

local function sendKey(keyCode)
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
        task.wait(0.03)
        VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
    end)
end

local function castConfiguredSkills()
    if tick() - State.LastSkillCast < Config.SkillCooldown then return end
    State.LastSkillCast = tick()

    if Config.SkillWeaponType then
        equipWeapon(Config.SkillWeaponType)
    end

    if Config.AutoSkillZ then sendKey(Enum.KeyCode.Z) end
    if Config.AutoSkillX then sendKey(Enum.KeyCode.X) end
    if Config.AutoSkillC then sendKey(Enum.KeyCode.C) end
    if Config.AutoSkillV then sendKey(Enum.KeyCode.V) end
end

local function ensureBusoAndHaki()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local commF = remotes and remotes:FindFirstChild("CommF_")
    if not commF then return end

    if Config.AutoBuso and tick() - State.LastBuso > 5 then
        State.LastBuso = tick()
        pcall(function()
            commF:InvokeServer("Buso")
        end)
    end

    if Config.AutoObservation and tick() - State.LastKen > 8 then
        State.LastKen = tick()
        pcall(function()
            commF:InvokeServer("Ken")
        end)
    end
end

local function fastAttack()
    local now = tick()
    if now - State.LastAttack < Config.AttackCooldown then return end
    State.LastAttack = now

    ensureBusoAndHaki()

    local char = LocalPlayer.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    if tool then
        pcall(function()
            tool:Activate()
        end)
    end

    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
        task.wait(0.02)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
    end)
end

local function bringNearbyEnemies(centerPos, radius)
    if tick() - State.LastBring < 0.35 then return end
    State.LastBring = tick()

    local enemiesFolder = workspace:FindFirstChild("Enemies")
    if not enemiesFolder or not centerPos then return end

    local pullTarget = centerPos + Vector3.new(0, 0, -4)
    for _, mob in ipairs(enemiesFolder:GetChildren()) do
        local hum = mob:FindFirstChildOfClass("Humanoid")
        local mRoot = mob:FindFirstChild("HumanoidRootPart")
        if hum and hum.Health > 0 and mRoot then
            local dist = (mRoot.Position - centerPos).Magnitude
            if dist <= (radius or 60) then
                pcall(function()
                    mRoot.CFrame = CFrame.new(pullTarget)
                    mRoot.CanCollide = false
                end)
            end
        end
    end
end

local function findNearestEnemy(nameFilter)
    local root = getRoot()
    if not root then return nil end

    local enemiesFolder = workspace:FindFirstChild("Enemies")
    if not enemiesFolder then return nil end

    local bestEnemy = nil
    local bestDist = math.huge

    for _, mob in ipairs(enemiesFolder:GetChildren()) do
        local hum = mob:FindFirstChildOfClass("Humanoid")
        local mRoot = mob:FindFirstChild("HumanoidRootPart")
        if hum and hum.Health > 0 and mRoot then
            local match = (nameFilter == nil) or string.find(string.lower(mob.Name), string.lower(nameFilter), 1, true) ~= nil
            if match then
                local d = (root.Position - mRoot.Position).Magnitude
                if d < bestDist then
                    bestDist = d
                    bestEnemy = mob
                end
            end
        end
    end

    return bestEnemy
end

local function findNearestChest()
    local root = getRoot()
    if not root then return nil end

    local bestChest = nil
    local bestDist = math.huge

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and string.find(string.lower(obj.Name), "chest", 1, true) then
            local d = (root.Position - obj.Position).Magnitude
            if d < bestDist then
                bestDist = d
                bestChest = obj
            end
        end
    end

    return bestChest
end

local function randomBones()
    if tick() - State.LastBoneSpin < 1.2 then return end
    State.LastBoneSpin = tick()

    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local commF = remotes and remotes:FindFirstChild("CommF_")
    if commF then
        pcall(function()
            commF:InvokeServer("Bones", "Buy", 1, 1)
        end)
    end
end

local function hasActiveQuestUI()
    local gui = LocalPlayer:FindFirstChild("PlayerGui")
    local main = gui and gui:FindFirstChild("Main")
    local questFrame = main and main:FindFirstChild("Quest")
    if questFrame and questFrame:IsA("GuiObject") then
        return questFrame.Visible
    end
    return false
end

local function ensureLevelQuest(entry)
    if not Config.AutoQuest or not entry then return end
    if hasActiveQuestUI() then return end
    if tick() - State.LastLevelQuest < 2.0 then return end
    State.LastLevelQuest = tick()

    local root = getRoot()
    if root and entry.QuestPos then
        local dist = (root.Position - entry.QuestPos).Magnitude
        if dist > 20 then
            setStatus("Moving to Quest: " .. entry.Mob)
            tweenToCFrame(CFrame.new(entry.QuestPos + Vector3.new(0, 3, 0)))
        end
    end

    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local commF = remotes and remotes:FindFirstChild("CommF_")
    if commF then
        pcall(function()
            commF:InvokeServer("StartQuest", entry.QuestName, entry.QuestId)
        end)
    end
end

local function ensureQuest(targetMode)
    if not Config.AutoQuest then return end
    if hasActiveQuestUI() then return end
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local commF = remotes and remotes:FindFirstChild("CommF_")
    if not commF then return end

    pcall(function()
        if targetMode == "Bones" then
            commF:InvokeServer("StartQuest", "HauntedQuest1", 1)
        elseif targetMode == "Cake Prince" then
            commF:InvokeServer("StartQuest", "CakeQuest2", 2)
        end
    end)
end

local function ensureEliteQuest()
    if not Config.AutoEliteQuest then return end
    if tick() - State.LastEliteQuest < 2.5 then return end
    State.LastEliteQuest = tick()

    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local commF = remotes and remotes:FindFirstChild("CommF_")
    if commF then
        pcall(function()
            commF:InvokeServer("EliteHunter")
        end)
    end
end

local function clearEsp()
    if State.EspFolder then
        State.EspFolder:Destroy()
        State.EspFolder = nil
    end
end

local function updateEsp()
    clearEsp()
    if not (Config.EspPlayers or Config.EspChests or Config.EspFruits or Config.EspMobs or Config.EspElites) then
        return
    end

    local folder = Instance.new("Folder")
    folder.Name = "RealKidEspFolder"
    folder.Parent = workspace:FindFirstChild("CurrentCamera") or workspace
    State.EspFolder = folder

    if Config.EspPlayers then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local box = Instance.new("BoxHandleAdornment")
                box.Name = "PlayerEsp_" .. plr.Name
                box.Adornee = plr.Character.HumanoidRootPart
                box.Size = Vector3.new(4, 6, 2)
                box.Color3 = Color3.fromRGB(255, 70, 70)
                box.Transparency = 0.45
                box.AlwaysOnTop = true
                box.ZIndex = 5
                box.Parent = folder
            end
        end
    end

    if Config.EspChests then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and string.find(string.lower(obj.Name), "chest", 1, true) then
                local box = Instance.new("BoxHandleAdornment")
                box.Name = "ChestEsp"
                box.Adornee = obj
                box.Size = obj.Size + Vector3.new(0.5, 0.5, 0.5)
                box.Color3 = Color3.fromRGB(255, 210, 50)
                box.Transparency = 0.45
                box.AlwaysOnTop = true
                box.ZIndex = 4
                box.Parent = folder
            end
        end
    end

    if Config.EspFruits then
        for _, obj in ipairs(workspace:GetChildren()) do
            if obj:IsA("Tool") and string.find(string.lower(obj.Name), "fruit", 1, true) then
                local handle = obj:FindFirstChild("Handle")
                if handle and handle:IsA("BasePart") then
                    local box = Instance.new("BoxHandleAdornment")
                    box.Name = "FruitEsp_" .. obj.Name
                    box.Adornee = handle
                    box.Size = handle.Size + Vector3.new(1, 1, 1)
                    box.Color3 = Color3.fromRGB(90, 235, 140)
                    box.Transparency = 0.35
                    box.AlwaysOnTop = true
                    box.ZIndex = 6
                    box.Parent = folder
                end
            end
        end
    end

    if Config.EspMobs or Config.EspElites then
        local enemiesFolder = workspace:FindFirstChild("Enemies")
        if enemiesFolder then
            for _, mob in ipairs(enemiesFolder:GetChildren()) do
                local hum = mob:FindFirstChildOfClass("Humanoid")
                local mRoot = mob:FindFirstChild("HumanoidRootPart")
                if hum and hum.Health > 0 and mRoot then
                    local elite = isEliteBossName(mob.Name)
                    if (elite and Config.EspElites) or (not elite and Config.EspMobs) then
                        local box = Instance.new("BoxHandleAdornment")
                        box.Name = "MobEsp_" .. mob.Name
                        box.Adornee = mRoot
                        box.Size = Vector3.new(4, 5, 3)
                        box.Color3 = elite and Color3.fromRGB(255, 140, 40) or Color3.fromRGB(145, 110, 255)
                        box.Transparency = 0.45
                        box.AlwaysOnTop = true
                        box.ZIndex = 4
                        box.Parent = folder
                    end
                end
            end
        end
    end
end

local function buildUI()
    local existing = LocalPlayer:FindFirstChild("PlayerGui"):FindFirstChild("RealKidReplicaUI")
    if existing then
        existing:Destroy()
    end

    local gui = Instance.new("ScreenGui")
    gui.Name = "RealKidReplicaUI"
    gui.ResetOnSpawn = false
    gui.Parent = LocalPlayer:WaitForChild("PlayerGui")

    local mainFrame = Instance.new("Frame")
    mainFrame.Name = "MainHub"
    mainFrame.Size = UDim2.fromOffset(560, 340)
    mainFrame.Position = UDim2.fromOffset(110, 80)
    mainFrame.BackgroundColor3 = Color3.fromRGB(24, 26, 32)
    mainFrame.BorderSizePixel = 0
    mainFrame.Active = true
    mainFrame.Draggable = true
    mainFrame.Parent = gui

    local floatBtn = Instance.new("TextButton")
    floatBtn.Name = "MobileToggleButton"
    floatBtn.Size = UDim2.fromOffset(48, 48)
    floatBtn.Position = UDim2.fromOffset(24, 140)
    floatBtn.BackgroundColor3 = Color3.fromRGB(45, 115, 215)
    floatBtn.TextColor3 = Color3.new(1, 1, 1)
    floatBtn.Font = Enum.Font.GothamBold
    floatBtn.TextSize = 12
    floatBtn.Text = "RK"
    floatBtn.Active = true
    floatBtn.Draggable = true
    floatBtn.ZIndex = 20
    floatBtn.Parent = gui

    local floatCorner = Instance.new("UICorner")
    floatCorner.CornerRadius = UDim.new(1, 0)
    floatCorner.Parent = floatBtn

    local function syncFloatButton()
        if mainFrame.Visible then
            floatBtn.Text = "RK"
            floatBtn.BackgroundColor3 = Color3.fromRGB(45, 115, 215)
        else
            floatBtn.Text = "OPEN"
            floatBtn.BackgroundColor3 = Color3.fromRGB(40, 145, 85)
        end
    end

    floatBtn.MouseButton1Click:Connect(function()
        mainFrame.Visible = not mainFrame.Visible
        syncFloatButton()
    end)

    syncFloatButton()

    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size = UDim2.new(1, 0, 0, 32)
    titleLabel.BackgroundColor3 = Color3.fromRGB(16, 18, 22)
    titleLabel.TextColor3 = Color3.fromRGB(240, 245, 255)
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.TextSize = 14
    titleLabel.Text = "  RealKid Hub | Blox Fruits"
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Parent = mainFrame

    local statusBanner = Instance.new("TextLabel")
    statusBanner.Name = "StatusBanner"
    statusBanner.Size = UDim2.new(1, -156, 0, 22)
    statusBanner.Position = UDim2.fromOffset(148, 36)
    statusBanner.BackgroundColor3 = Color3.fromRGB(20, 22, 28)
    statusBanner.TextColor3 = Color3.fromRGB(145, 215, 255)
    statusBanner.Font = Enum.Font.GothamSemibold
    statusBanner.TextSize = 11
    statusBanner.Text = "Status: Idle"
    statusBanner.TextXAlignment = Enum.TextXAlignment.Left
    statusBanner.Parent = mainFrame

    local sidebar = Instance.new("ScrollingFrame")
    sidebar.Size = UDim2.new(0, 140, 1, -32)
    sidebar.Position = UDim2.fromOffset(0, 32)
    sidebar.BackgroundColor3 = Color3.fromRGB(30, 33, 41)
    sidebar.BorderSizePixel = 0
    sidebar.ScrollBarThickness = 3
    sidebar.Parent = mainFrame

    local sideLayout = Instance.new("UIListLayout")
    sideLayout.Padding = UDim.new(0, 4)
    sideLayout.Parent = sidebar

    local content = Instance.new("ScrollingFrame")
    content.Size = UDim2.new(1, -156, 1, -68)
    content.Position = UDim2.fromOffset(148, 62)
    content.BackgroundColor3 = Color3.fromRGB(36, 39, 48)
    content.BorderSizePixel = 0
    content.ScrollBarThickness = 4
    content.Parent = mainFrame

    local contentLayout = Instance.new("UIListLayout")
    contentLayout.Padding = UDim.new(0, 7)
    contentLayout.Parent = content

    contentLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        content.CanvasSize = UDim2.fromOffset(0, contentLayout.AbsoluteContentSize.Y + 12)
    end)

    local function clearContent()
        State.EliteProcessLabel = nil
        State.CakeProcessLabel = nil
        State.LevelInfoLabel = nil
        for _, child in ipairs(content:GetChildren()) do
            if not child:IsA("UIListLayout") then
                child:Destroy()
            end
        end
    end

    local function addInfo(text)
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, -12, 0, 26)
        lbl.BackgroundColor3 = Color3.fromRGB(28, 31, 39)
        lbl.TextColor3 = Color3.fromRGB(215, 222, 238)
        lbl.Font = Enum.Font.Gotham
        lbl.TextSize = 12
        lbl.Text = "  " .. tostring(text)
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Parent = content
        return lbl
    end

    local function addToggle(labelText, initial, callback)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -12, 0, 32)
        btn.BackgroundColor3 = initial and Color3.fromRGB(40, 120, 75) or Color3.fromRGB(52, 56, 68)
        btn.TextColor3 = Color3.new(1, 1, 1)
        btn.Font = Enum.Font.GothamSemibold
        btn.TextSize = 12
        btn.Text = labelText .. ": " .. (initial and "ON" or "OFF")
        btn.Parent = content

        local state = initial
        btn.MouseButton1Click:Connect(function()
            state = not state
            btn.BackgroundColor3 = state and Color3.fromRGB(40, 120, 75) or Color3.fromRGB(52, 56, 68)
            btn.Text = labelText .. ": " .. (state and "ON" or "OFF")
            callback(state)
        end)
    end

    local function addActionButton(labelText, callback)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -12, 0, 32)
        btn.BackgroundColor3 = Color3.fromRGB(55, 85, 145)
        btn.TextColor3 = Color3.new(1, 1, 1)
        btn.Font = Enum.Font.GothamSemibold
        btn.TextSize = 12
        btn.Text = labelText
        btn.Parent = content
        btn.MouseButton1Click:Connect(callback)
    end

    local tabs = {
        "Discord",
        "Server",
        "Shop",
        "Farm",
        "Skill Settings",
        "Stack Farming",
        "PVP",
        "Fishing/Slap Fish",
        "Esp"
    }

    local function openTab(tabName)
        clearContent()

        if tabName == "Discord" then
            addInfo("RealKid Hub Community")
            addActionButton("Copy Discord Invite Link", function()
                if setclipboard then
                    pcall(function()
                        setclipboard("https://discord.gg/realkidhub")
                    end)
                end
                setStatus("Discord link copied")
            end)

        elseif tabName == "Server" then
            addInfo("PlaceId: " .. tostring(game.PlaceId) .. " | Players: " .. tostring(#Players:GetPlayers()))
            addInfo("JobId: " .. tostring(game.JobId))
            addToggle("Anti-AFK", Config.AntiAFK, function(v) Config.AntiAFK = v end)
            addActionButton("Copy JobId", function()
                if setclipboard then
                    pcall(function() setclipboard(tostring(game.JobId)) end)
                end
                setStatus("JobId copied")
            end)
            addActionButton("Rejoin Current Server", function()
                setStatus("Rejoining server...")
                pcall(function()
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
                end)
            end)

        elseif tabName == "Shop" then
            addActionButton("Buy Buso Haki", function()
                local commF = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
                if commF then
                    pcall(function() commF:InvokeServer("BuyHaki", "Buso") end)
                end
                setStatus("Requested Buso Haki")
            end)
            addActionButton("Buy Observation Haki", function()
                local commF = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
                if commF then
                    pcall(function() commF:InvokeServer("KenTalk", "Buy") end)
                end
                setStatus("Requested Observation Haki")
            end)
            addActionButton("Buy Geppo / Air Jump", function()
                local commF = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
                if commF then
                    pcall(function() commF:InvokeServer("BuyHaki", "Geppo") end)
                end
                setStatus("Requested Geppo")
            end)
            addActionButton("Buy Flash Step", function()
                local commF = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
                if commF then
                    pcall(function() commF:InvokeServer("BuyHaki", "Soru") end)
                end
                setStatus("Requested Flash Step")
            end)
            addActionButton("Buy Random Bones (Spin)", function()
                State.LastBoneSpin = 0
                randomBones()
                setStatus("Requested Random Bones")
            end)
            addActionButton("Buy Katana", function()
                local commF = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
                if commF then
                    pcall(function() commF:InvokeServer("BuyItem", "Katana") end)
                end
                setStatus("Requested Katana")
            end)
            addActionButton("Buy Cutlass", function()
                local commF = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
                if commF then
                    pcall(function() commF:InvokeServer("BuyItem", "Cutlass") end)
                end
                setStatus("Requested Cutlass")
            end)
            addActionButton("Buy Pipe", function()
                local commF = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
                if commF then
                    pcall(function() commF:InvokeServer("BuyItem", "Pipe") end)
                end
                setStatus("Requested Pipe")
            end)
            addActionButton("Buy Black Cape", function()
                local commF = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
                if commF then
                    pcall(function() commF:InvokeServer("BuyItem", "Black Cape") end)
                end
                setStatus("Requested Black Cape")
            end)

        elseif tabName == "Farm" then
            State.LevelInfoLabel = addInfo("")
            refreshLevelInfoLabel()
            addActionButton("Select Weapon: " .. Config.WeaponType .. " (Cycle)", function()
                Config.WeaponType = cycleItem(WeaponTypes, Config.WeaponType)
                openTab("Farm")
            end)
            addActionButton("Select Target: " .. Config.FarmTarget .. " (Cycle)", function()
                local targets = {"Auto Level", "Bones", "Cake Prince", "Nearest Mob"}
                Config.FarmTarget = cycleItem(targets, Config.FarmTarget)
                openTab("Farm")
            end)
            addActionButton("Farm Speed: " .. tostring(Config.FarmSpeed) .. " (Cycle)", function()
                if Config.FarmSpeed == 180 then
                    Config.FarmSpeed = 260
                elseif Config.FarmSpeed == 260 then
                    Config.FarmSpeed = 340
                else
                    Config.FarmSpeed = 180
                end
                openTab("Farm")
            end)
            addToggle("Auto Farm", Config.AutoFarm, function(v) Config.AutoFarm = v end)
            addToggle("Auto Farm Level", Config.AutoFarmLevel, function(v)
                Config.AutoFarmLevel = v
                if v then
                    Config.FarmTarget = "Auto Level"
                    refreshLevelInfoLabel()
                end
            end)
            addToggle("Auto Farm Bones", Config.AutoFarmBones, function(v)
                Config.AutoFarmBones = v
                if v then Config.FarmTarget = "Bones" end
            end)
            addToggle("Auto Farm Cake Prince", Config.AutoFarmCakePrince, function(v)
                Config.AutoFarmCakePrince = v
                if v then Config.FarmTarget = "Cake Prince" end
            end)
            addToggle("Auto Farm Nearest Mob", Config.AutoFarmNearest, function(v)
                Config.AutoFarmNearest = v
                if v then Config.FarmTarget = "Nearest Mob" end
            end)
            addToggle("Ignore Cake Prince", Config.IgnoreCakePrince, function(v) Config.IgnoreCakePrince = v end)
            addToggle("Accept Quests", Config.AutoQuest, function(v) Config.AutoQuest = v end)
            addToggle("Fast Attack", Config.FastAttack, function(v) Config.FastAttack = v end)
            addToggle("Bring Mob", Config.BringMob, function(v) Config.BringMob = v end)
            addToggle("Auto Equip Weapon", Config.AutoEquipWeapon, function(v) Config.AutoEquipWeapon = v end)
            addToggle("Auto Buso Haki", Config.AutoBuso, function(v) Config.AutoBuso = v end)
            addToggle("Auto Random Bones", Config.AutoRandomBones, function(v) Config.AutoRandomBones = v end)
            addActionButton("Spin Bones Now", function()
                State.LastBoneSpin = 0
                randomBones()
                setStatus("Spun Bones")
            end)
            addToggle("Auto Collect Chest", Config.AutoCollectChest, function(v) Config.AutoCollectChest = v end)

        elseif tabName == "Skill Settings" then
            addActionButton("Skill Weapon: " .. Config.SkillWeaponType .. " (Cycle)", function()
                Config.SkillWeaponType = cycleItem(WeaponTypes, Config.SkillWeaponType)
                openTab("Skill Settings")
            end)
            addActionButton("Skill Cooldown: " .. tostring(Config.SkillCooldown) .. "s (Cycle)", function()
                if Config.SkillCooldown == 1.6 then
                    Config.SkillCooldown = 2.2
                elseif Config.SkillCooldown == 2.2 then
                    Config.SkillCooldown = 1.0
                else
                    Config.SkillCooldown = 1.6
                end
                openTab("Skill Settings")
            end)
            addToggle("Auto Skill Z", Config.AutoSkillZ, function(v) Config.AutoSkillZ = v end)
            addToggle("Auto Skill X", Config.AutoSkillX, function(v) Config.AutoSkillX = v end)
            addToggle("Auto Skill C", Config.AutoSkillC, function(v) Config.AutoSkillC = v end)
            addToggle("Auto Skill V", Config.AutoSkillV, function(v) Config.AutoSkillV = v end)
            addToggle("Auto Buso Haki", Config.AutoBuso, function(v) Config.AutoBuso = v end)
            addToggle("Auto Observation Haki", Config.AutoObservation, function(v) Config.AutoObservation = v end)

        elseif tabName == "Stack Farming" then
            State.EliteProcessLabel = addInfo("Elites Process: " .. tostring(State.EliteCount))
            State.CakeProcessLabel = addInfo("Cake Prince Progress: " .. tostring(State.CakeMobCount) .. " / 500")
            addActionButton("Reset Elites Process", function()
                State.EliteCount = 0
                refreshEliteProgressLabel()
                setStatus("Elites Process reset to 0")
            end)
            addToggle("Auto Elite Quest", Config.AutoEliteQuest, function(v) Config.AutoEliteQuest = v end)
            addToggle("Auto Farm Elite Hunter", Config.AutoEliteHunter, function(v) Config.AutoEliteHunter = v end)
            for _, eName in ipairs(EliteNames) do
                addActionButton("Hunt Elite: " .. eName, function()
                    local targetElite = findNearestEnemy(eName)
                    if targetElite and targetElite:FindFirstChild("HumanoidRootPart") then
                        setStatus("Flying to " .. eName)
                        equipWeapon(Config.WeaponType)
                        tweenToCFrame(targetElite.HumanoidRootPart.CFrame * CFrame.new(0, 8, 0))
                        fastAttack()
                        castConfiguredSkills()
                    else
                        setStatus(eName .. " not spawned")
                    end
                end)
            end

        elseif tabName == "PVP" then
            addActionButton("Target Player: " .. tostring(Config.SelectedPVPTarget) .. " (Cycle)", function()
                local names = {"Nearest"}
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer then
                        table.insert(names, plr.Name)
                    end
                end
                Config.SelectedPVPTarget = cycleItem(names, Config.SelectedPVPTarget)
                openTab("PVP")
            end)
            addToggle("Auto Aim / Attack Player", Config.AutoAimPVP, function(v) Config.AutoAimPVP = v end)
            addToggle("Bring Mob For PVP", Config.BringMobPVP, function(v) Config.BringMobPVP = v end)
            addToggle("Auto Buso / Ken In PVP", Config.AutoKenPVP, function(v) Config.AutoKenPVP = v end)
            addToggle("Use Skills In PVP", Config.UseSkillsPVP, function(v) Config.UseSkillsPVP = v end)
            addActionButton("Stop PVP", function()
                Config.AutoAimPVP = false
                setStatus("PVP Stopped")
                openTab("PVP")
            end)

        elseif tabName == "Fishing/Slap Fish" then
            addToggle("Auto Slap Fish", Config.AutoSlapFish, function(v) Config.AutoSlapFish = v end)
            addToggle("Auto Fishing", Config.AutoFishing, function(v) Config.AutoFishing = v end)
            addToggle("Auto Equip Tool", Config.AutoEquipWeapon, function(v) Config.AutoEquipWeapon = v end)
            addActionButton("Manual Slap / Cast", function()
                equipWeapon(nil)
                fastAttack()
                castConfiguredSkills()
                setStatus("Manual Slap / Cast executed")
            end)

        elseif tabName == "Esp" then
            addToggle("Auto Refresh ESP", Config.AutoRefreshEsp, function(v) Config.AutoRefreshEsp = v end)
            addToggle("ESP Players", Config.EspPlayers, function(v)
                Config.EspPlayers = v
                updateEsp()
            end)
            addToggle("ESP Chests", Config.EspChests, function(v)
                Config.EspChests = v
                updateEsp()
            end)
            addToggle("ESP Fruits", Config.EspFruits, function(v)
                Config.EspFruits = v
                updateEsp()
            end)
            addToggle("ESP Mobs", Config.EspMobs, function(v)
                Config.EspMobs = v
                updateEsp()
            end)
            addToggle("ESP Elite Bosses", Config.EspElites, function(v)
                Config.EspElites = v
                updateEsp()
            end)
            addActionButton("Refresh ESP Now", function()
                updateEsp()
                setStatus("ESP Refreshed")
            end)
        end
    end

    for _, name in ipairs(tabs) do
        local tabBtn = Instance.new("TextButton")
        tabBtn.Size = UDim2.new(1, 0, 0, 26)
        tabBtn.BackgroundColor3 = Color3.fromRGB(40, 44, 54)
        tabBtn.TextColor3 = Color3.fromRGB(230, 235, 245)
        tabBtn.Font = Enum.Font.Gotham
        tabBtn.TextSize = 12
        tabBtn.Text = name
        tabBtn.Parent = sidebar
        tabBtn.MouseButton1Click:Connect(function()
            openTab(name)
        end)
    end

    sidebar.CanvasSize = UDim2.fromOffset(0, #tabs * 30 + 8)
    openTab("Farm")
end

buildUI()

LocalPlayer.Idled:Connect(function()
    if Config.AntiAFK then
        pcall(function()
            VirtualUser:CaptureController()
            VirtualUser:ClickButton2(Vector2.new())
        end)
    end
end)

task.spawn(function()
    while true do
        task.wait(0.15)

        pcall(trackEliteKills)
        pcall(refreshLevelInfoLabel)

        if Config.AutoRandomBones then
            randomBones()
        end

        if Config.AutoRefreshEsp and (Config.EspPlayers or Config.EspChests or Config.EspFruits or Config.EspMobs or Config.EspElites) then
            if tick() - State.LastEspRefresh > 2.5 then
                State.LastEspRefresh = tick()
                pcall(updateEsp)
            end
        end

        local anyFarmActive = Config.AutoFarm or Config.AutoFarmLevel or Config.AutoFarmBones or Config.AutoFarmCakePrince or Config.AutoFarmNearest

        if Config.AutoSlapFish then
            setStatus("Auto Slap Fish")
            equipWeapon(nil)
            if Config.FastAttack then fastAttack() end
        elseif Config.AutoFishing then
            setStatus("Auto Fishing")
            equipWeapon(nil)
            if Config.FastAttack then fastAttack() end
        elseif Config.AutoAimPVP then
            local root = getRoot()
            local targetPlr = nil
            local bestDist = math.huge
            if root then
                if Config.BringMobPVP then
                    bringNearbyEnemies(root.Position, 55)
                end
                if Config.AutoKenPVP then
                    ensureBusoAndHaki()
                end
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer and plr.Character then
                        local tRoot = plr.Character:FindFirstChild("HumanoidRootPart")
                        local tHum = plr.Character:FindFirstChildOfClass("Humanoid")
                        if tRoot and tHum and tHum.Health > 0 then
                            if Config.SelectedPVPTarget == plr.Name then
                                targetPlr = plr
                                break
                            elseif Config.SelectedPVPTarget == "Nearest" then
                                local d = (root.Position - tRoot.Position).Magnitude
                                if d < bestDist then
                                    bestDist = d
                                    targetPlr = plr
                                end
                            end
                        end
                    end
                end
            end
            if targetPlr and targetPlr.Character and targetPlr.Character:FindFirstChild("HumanoidRootPart") then
                setStatus("PVP Target: " .. targetPlr.Name)
                equipWeapon(Config.WeaponType)
                tweenToCFrame(targetPlr.Character.HumanoidRootPart.CFrame * CFrame.new(0, 4, 3))
                if Config.FastAttack then fastAttack() end
                if Config.UseSkillsPVP then castConfiguredSkills() end
            else
                setStatus("PVP: No Target")
            end
        elseif Config.AutoCollectChest then
            local chest = findNearestChest()
            if chest then
                setStatus("Collecting Chest")
                equipWeapon(Config.WeaponType)
                tweenToCFrame(chest.CFrame * CFrame.new(0, 2, 0))
            else
                setStatus("No Chest Found")
            end
        elseif Config.AutoEliteHunter then
            ensureEliteQuest()
            local elite = findNearestEnemy("Diablo") or findNearestEnemy("Deandre") or findNearestEnemy("Urban")
            if elite and elite:FindFirstChild("HumanoidRootPart") then
                setStatus("Elite Hunter: " .. elite.Name)
                equipWeapon(Config.WeaponType)
                tweenToCFrame(elite.HumanoidRootPart.CFrame * CFrame.new(0, 8, 0))
                if Config.BringMob then
                    bringNearbyEnemies(elite.HumanoidRootPart.Position, 55)
                end
                if Config.FastAttack then fastAttack() end
                castConfiguredSkills()
            else
                setStatus("Elite Hunter: Waiting")
            end
        elseif anyFarmActive then
            local mode = Config.FarmTarget
            if Config.AutoFarmLevel then
                mode = "Auto Level"
            elseif Config.AutoFarmBones then
                mode = "Bones"
            elseif Config.AutoFarmCakePrince then
                mode = "Cake Prince"
            elseif Config.AutoFarmNearest then
                mode = "Nearest Mob"
            end

            if mode == "Auto Level" then
                local entry = getLevelEntry()
                ensureLevelQuest(entry)
                local mob = findNearestEnemy(entry.Mob)
                if mob and mob:FindFirstChild("HumanoidRootPart") then
                    setStatus(string.format("Lv.%d | %s", getPlayerLevel(), mob.Name))
                    equipWeapon(Config.WeaponType)
                    tweenToCFrame(mob.HumanoidRootPart.CFrame * CFrame.new(0, 8, 0))
                    if Config.BringMob then
                        bringNearbyEnemies(mob.HumanoidRootPart.Position, 60)
                    end
                    if Config.FastAttack then fastAttack() end
                    castConfiguredSkills()
                else
                    setStatus(string.format("Moving to %s", entry.Mob))
                    tweenToCFrame(CFrame.new(entry.MobPos + Vector3.new(0, 8, 0)))
                end
            else
                ensureQuest(mode)
                local filter = nil
                if mode == "Bones" then
                    filter = "Reborn Skeleton"
                elseif mode == "Cake Prince" and not Config.IgnoreCakePrince then
                    filter = "Cake Prince"
                elseif mode == "Nearest Mob" then
                    filter = nil
                end

                local mob = findNearestEnemy(filter) or findNearestEnemy(nil)
                if mob and mob:FindFirstChild("HumanoidRootPart") then
                    setStatus("Farming: " .. mob.Name)
                    equipWeapon(Config.WeaponType)
                    tweenToCFrame(mob.HumanoidRootPart.CFrame * CFrame.new(0, 8, 0))
                    if Config.BringMob then
                        bringNearbyEnemies(mob.HumanoidRootPart.Position, 60)
                    end
                    if Config.FastAttack then fastAttack() end
                    castConfiguredSkills()
                else
                    setStatus("Farming: Searching Mob")
                end
            end
        else
            setNoclip(false)
            setStatus("Idle")
        end
    end
end)

Players.PlayerAdded:Connect(function()
    if Config.EspPlayers then
        updateEsp()
    end
end)

Players.PlayerRemoving:Connect(function()
    if Config.EspPlayers then
        updateEsp()
    end
end)
